# ===========================================================================
# Step 4.1.1: USD-to-USD Transaction (Identity Conversion)
# ===========================================================================
# @name step_4_1_1_usd_injection
POST {{baseUrl}}/api/v1/finance/funding/capital-injections
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "target_entity_code": "US-TEST",
  "funding_source": "FOUNDER_EQUITY",
  "amount": 50000.00,
  "funding_date": "2026-05-26",
  "source_account_id": "{{us_equity_account_id}}",
  "destination_account_id": "{{us_bank_account_id}}",
  "referenceNumber": "TST-USD-001"
}

> {%
    client.test("USD Injection — Status 201", function() {
        client.assert(response.status === 201, "Expected 201 Created, got " + response.status);
    });
    client.test("USD Injection — amountLocal = 50000", function() {
        client.assert(response.body.data.amountLocal === 50000.0000,
            "Expected 50000.0000, got " + response.body.data.amountLocal);
    });
    client.test("USD Injection — currencyLocal = USD", function() {
        client.assert(response.body.data.currencyLocal === "USD",
            "Expected USD, got " + response.body.data.currencyLocal);
    });
    client.test("USD Injection — amountUsd = 50000 (1:1)", function() {
        client.assert(response.body.data.amountUsd === 50000.0000,
            "Expected 50000.0000, got " + response.body.data.amountUsd);
    });
    client.test("USD Injection — exchangeRateUsed = 1.0", function() {
        client.assert(response.body.data.exchangeRateUsed === 1.000000,
            "Expected 1.000000, got " + response.body.data.exchangeRateUsed);
    });
    client.test("USD Injection — rateSource = IDENTITY", function() {
        client.assert(response.body.data.rateSource === "IDENTITY",
            "Expected IDENTITY, got " + response.body.data.rateSource);
    });
    client.test("USD Injection — rateWarning = false", function() {
        client.assert(response.body.data.rateWarning === false,
            "Expected false, got " + response.body.data.rateWarning);
    });
    if (response.body.data && response.body.data.capitalInjectionId) {
        client.global.set("us_injection_id", response.body.data.capitalInjectionId);
        client.log("Captured us_injection_id = " + response.body.data.capitalInjectionId);
    }
%}

###

# ===========================================================================
# Step 4.2.1: INR-to-USD Transaction (Exact-Date Rate Lookup)
# Uses funding_date 2026-05-21 — rate 0.012100 from CSV import
# Expected amountUsd = 100000 * 0.012100 = 1210.0000
# ===========================================================================
# @name step_4_2_1_inr_injection
POST {{baseUrl}}/api/v1/finance/funding/capital-injections
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "target_entity_code": "IN-TEST",
  "funding_source": "FOUNDER_EQUITY",
  "amount": 100000.00,
  "funding_date": "2026-05-21",
  "source_account_id": "{{india_equity_account_id}}",
  "destination_account_id": "{{india_bank_account_id}}",
  "referenceNumber": "TST-INR-001"
}

> {%
    client.test("INR Injection — Status 201", function() {
        client.assert(response.status === 201, "Expected 201 Created, got " + response.status);
    });
    client.test("INR Injection — amountLocal = 100000", function() {
        client.assert(response.body.data.amountLocal === 100000.0000,
            "Expected 100000.0000, got " + response.body.data.amountLocal);
    });
    client.test("INR Injection — currencyLocal = INR", function() {
        client.assert(response.body.data.currencyLocal === "INR",
            "Expected INR, got " + response.body.data.currencyLocal);
    });
    client.test("INR Injection — amountUsd = 1210.0000", function() {
        client.assert(response.body.data.amountUsd === 1210.0000,
            "Expected 1210.0000 (100000 * 0.012100), got " + response.body.data.amountUsd);
    });
    client.test("INR Injection — exchangeRateUsed = 0.012100", function() {
        client.assert(response.body.data.exchangeRateUsed === 0.012100,
            "Expected 0.012100, got " + response.body.data.exchangeRateUsed);
    });
    client.test("INR Injection — rateDateUsed = 2026-05-21", function() {
        client.assert(response.body.data.rateDateUsed === "2026-05-21",
            "Expected 2026-05-21, got " + response.body.data.rateDateUsed);
    });
    client.test("INR Injection — rateSource is MANUAL or CSV", function() {
        var src = response.body.data.rateSource;
        client.assert(src === "MANUAL" || src === "CSV",
            "Expected MANUAL or CSV, got " + src);
    });
    client.test("INR Injection — rateWarning = false", function() {
        client.assert(response.body.data.rateWarning === false,
            "Expected false, got " + response.body.data.rateWarning);
    });
    client.test("INR Injection — capitalInjectionId is valid UUID", function() {
        client.assert(response.body.data.capitalInjectionId != null,
            "capitalInjectionId should be present");
    });
    client.test("INR Injection — journalId is valid UUID", function() {
        client.assert(response.body.data.journalId != null,
            "journalId should be present");
    });
    if (response.body.data && response.body.data.capitalInjectionId) {
        client.global.set("inr_injection_id", response.body.data.capitalInjectionId);
        client.log("Captured inr_injection_id = " + response.body.data.capitalInjectionId);
    }
%}

###

# ===========================================================================
# Step 4.3.1: Verify Ledger Entries (amount_usd + amount_local stored)
# ===========================================================================
# @name step_4_3_1_verify_ledger_entries
GET {{baseUrl}}/api/v1/finance/funding/capital-injections/{{inr_injection_id}}
Authorization: Bearer {{authToken}}

> {%
    client.test("Ledger Detail — Status 200", function() {
        client.assert(response.status === 200, "Expected 200 OK, got " + response.status);
    });
    client.test("Ledger Detail — 2 ledger entries (DEBIT + CREDIT)", function() {
        var entries = response.body.data.ledgerEntries;
        client.assert(entries != null, "ledgerEntries should be present");
        client.assert(entries.length === 2, "Expected 2 entries, got " + (entries ? entries.length : 0));
    });
    if (response.body.data.ledgerEntries && response.body.data.ledgerEntries.length === 2) {
        var e1 = response.body.data.ledgerEntries[0];
        var e2 = response.body.data.ledgerEntries[1];
        client.test("Ledger Detail — entry[0] has amountLocal = 100000", function() {
            client.assert(e1.amountLocal === 100000.0000,
                "Expected 100000.0000, got " + e1.amountLocal);
        });
        client.test("Ledger Detail — entry[0] has currencyLocal = INR", function() {
            client.assert(e1.currencyLocal === "INR",
                "Expected INR, got " + e1.currencyLocal);
        });
        client.test("Ledger Detail — entry[0] has amountUsd = 1210", function() {
            client.assert(e1.amountUsd === 1210.0000,
                "Expected 1210.0000, got " + e1.amountUsd);
        });
        client.test("Ledger Detail — entry[0] exchangeRateUsed = 0.012100", function() {
            client.assert(e1.exchangeRateUsed === 0.012100,
                "Expected 0.012100, got " + e1.exchangeRateUsed);
        });
        client.test("Ledger Detail — entry[0] rateWarning = false", function() {
            client.assert(e1.rateWarning === false,
                "Expected false, got " + e1.rateWarning);
        });
        client.test("Ledger Detail — entrySides are DEBIT and CREDIT", function() {
            var sides = [e1.entrySide, e2.entrySide];
            client.assert(sides.indexOf("DEBIT") !== -1, "DEBIT side missing");
            client.assert(sides.indexOf("CREDIT") !== -1, "CREDIT side missing");
        });
    }
%}

