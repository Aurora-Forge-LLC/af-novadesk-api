# ===========================================================================
# Step 6.1.1: Single-Entity Ledger Report — USD View (Default)
# ===========================================================================
# @name step_6_1_1_ledger_report_usd
GET {{baseUrl}}/api/v1/finance/reports/ledger?entityId={{india_entity_id}}&currency=USD
Authorization: Bearer {{authToken}}

> {%
    client.test("Ledger USD Report — Status 200", function() {
        client.assert(response.status === 200, "Expected 200 OK, got " + response.status);
    });
    client.test("Ledger USD Report — reportingCurrency = USD", function() {
        client.assert(response.body.data.reportingCurrency === "USD",
            "Expected USD, got " + response.body.data.reportingCurrency);
    });
    client.test("Ledger USD Report — entityBaseCurrency = INR", function() {
        client.assert(response.body.data.entityBaseCurrency === "INR",
            "Expected INR, got " + response.body.data.entityBaseCurrency);
    });
    client.test("Ledger USD Report — entityCode = IN-TEST", function() {
        client.assert(response.body.data.entityCode === "IN-TEST",
            "Expected IN-TEST, got " + response.body.data.entityCode);
    });
    client.test("Ledger USD Report — rows[] present", function() {
        client.assert(response.body.data.rows != null, "rows should be present");
        client.assert(Array.isArray(response.body.data.rows), "rows should be an array");
    });
    client.test("Ledger USD Report — each row currency = USD", function() {
        if (Array.isArray(response.body.data.rows)) {
            for (var i = 0; i < response.body.data.rows.length; i++) {
                client.assert(response.body.data.rows[i].currency === "USD",
                    "Row " + i + " currency expected USD, got " + response.body.data.rows[i].currency);
            }
        }
    });
    client.test("Ledger USD Report — pagination fields present", function() {
        client.assert(response.body.data.page !== undefined, "page missing");
        client.assert(response.body.data.size !== undefined, "size missing");
        client.assert(response.body.data.totalElements !== undefined, "totalElements missing");
        client.assert(response.body.data.totalPages !== undefined, "totalPages missing");
    });
%}

