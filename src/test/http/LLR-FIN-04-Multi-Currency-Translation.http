# ===========================================================================
# Step 6.5.1: Verify rateWarning Propagation in Reports
# ===========================================================================
# @name step_6_5_1_rate_warning_in_report
GET {{baseUrl}}/api/v1/finance/reports/ledger?entityId={{india_entity_id}}&currency=USD
Authorization: Bearer {{authToken}}

> {%
    client.test("RateWarning in Report — Status 200", function() {
        client.assert(response.status === 200, "Expected 200 OK, got " + response.status);
    });
    client.test("RateWarning in Report — at least one row has rateWarning = true", function() {
        var foundWarning = false;
        var foundNoWarning = false;
        if (Array.isArray(response.body.data.rows)) {
            for (var i = 0; i < response.body.data.rows.length; i++) {
                if (response.body.data.rows[i].rateWarning === true) {
                    foundWarning = true;
                }
                if (response.body.data.rows[i].rateWarning === false) {
                    foundNoWarning = true;
                }
            }
        }
        client.assert(foundWarning, "No row with rateWarning=true found (look-back injection should produce one)");
        client.log("rateWarning=true found: " + foundWarning + ", rateWarning=false found: " + foundNoWarning);
    });
%}

###

###############################################################################
### Error Case Matrix — Consolidated Reference
###############################################################################
# Test Case                              | Endpoint                             | Method | Expected | Assertion
# ---------------------------------------|--------------------------------------|--------|----------|----------------------------------
# Missing required field                 | /exchange-rates                      | POST   | 400      | metadata.errors[] populated (2.3.1)
# Duplicate rate (same pair + date)      | /exchange-rates                      | POST   | 409      | "already exists" (2.2.1)
# Rate not found by ID                   | /exchange-rates/{id}                 | GET    | 404      | "not found" (2.5.2)
# Approve non-existent rate              | /exchange-rates/{id}/approve         | PATCH  | 404      | "not found" (2.7.2)
# Delete non-existent rate               | /exchange-rates/{id}                 | DELETE | 404      | "not found" (2.8.4)
# Invalid CSV format                     | /exchange-rates/csv-upload           | POST   | 400/422  | parsing/invalid (3.4.1)
# No file attached                       | /exchange-rates/csv-upload           | POST   | 400      | (3.4.2)
# Negative exchange rate                 | /exchange-rates                      | POST   | 400      | validation error (2.3.3)
# Invalid currency length                | /exchange-rates                      | POST   | 400      | validation error (2.3.2)
# Entity not approved                    | /capital-injections                  | POST   | 400      | EntityNotApprovedException
# Entity not found                       | /capital-injections                  | POST   | 404      | "Entity not found"
# Missing exchange rate (no look-back)   | /capital-injections                  | POST   | 422      | "No exchange rate found" (5.2.1)
# Manual rate without justification      | /capital-injections                  | POST   | 400      | "justification" required (5.3.2)
# Manual rate without approver           | /capital-injections                  | POST   | 400      | "approver" required (5.3.3)
# Manual rate exceeds ceiling            | /capital-injections                  | POST   | 400      | "ceiling" exceeded (5.3.4)
# Non-existent entity for report         | /reports/ledger                      | GET    | 404      | "Entity not found" (6.3.4)
# Change currency pair on update         | /exchange-rates/{id}                 | PUT    | 400      | currency pair immutable (2.6.2)
