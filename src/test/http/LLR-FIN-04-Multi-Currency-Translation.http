###############################################################################
# LLR-FIN-04: Multi-Currency Translation Engine — IntelliJ HTTP Client Tests
#
# Prerequisites:
#   1. Ensure you have a valid JWT token with scope 'organizations:write'
#      and set it in your http-client.env.json file as "authToken".
#
# http-client.env.json example:
# {
#   "dev": {
#     "baseUrl": "http://localhost:9090/novadesk-api",
#     "authToken": "eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9..."
#   }
# }
#
# All responses are wrapped in ApiResponse:
#   { "success": bool, "code": int, "message": str, "data": ..., "timestamp": str }
#
# This file is fully self-contained. CSV test data is embedded inline — no
# external files are required.
###############################################################################

###############################################################################
### Section: Prerequisites & Dependency Setup
###############################################################################

# ===========================================================================
# Step 1.1.1: Create India Legal Entity (INR base currency)
# ===========================================================================
# @name step_1_1_1_create_india_entity
POST {{baseUrl}}/api/v1/legal-entities
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "entityName": "India Operations Test",
  "entityCode": "IN-TEST",
  "country": "IN",
  "baseCurrency": "INR",
  "taxId": null,
  "incorporationDate": "2020-01-15"
}

> {%
    client.test("Create India Entity — Status 201", function() {
        client.assert(response.status === 201, "Expected 201 Created, got " + response.status);
    });
    client.test("Create India Entity — data.id is present", function() {
        client.assert(response.body.data != null, "data should not be null");
        client.assert(response.body.data.id != null, "data.id should be a valid UUID");
    });
    client.test("Create India Entity — baseCurrency is INR", function() {
        client.assert(response.body.data.baseCurrency === "INR", "Expected INR, got " + response.body.data.baseCurrency);
    });
    if (response.body.data && response.body.data.id) {
        client.global.set("india_entity_id", response.body.data.id);
        client.log("Captured india_entity_id = " + response.body.data.id);
    }
%}

###

# ===========================================================================
# Step 1.2.1: Approve India Entity
# ===========================================================================
# @name step_1_2_1_approve_india_entity
POST {{baseUrl}}/api/v1/legal-entities/{{india_entity_id}}/approve
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "fiscalYearOverride": {
    "fiscalStartMonth": 4,
    "fiscalStartDay": 1,
    "fiscalEndMonth": 3,
    "fiscalEndDay": 31
  }
}

> {%
    client.test("Approve India Entity — Status 200", function() {
        client.assert(response.status === 200, "Expected 200 OK, got " + response.status);
    });
    client.test("Approve India Entity — approvalStatus is APPROVED", function() {
        client.assert(response.body.data != null, "data should not be null");
        client.assert(response.body.data.approvalStatus === "APPROVED",
            "Expected APPROVED, got " + response.body.data.approvalStatus);
    });
    client.test("Approve India Entity — CoA and bank accounts seeded", function() {
        client.assert(response.body.data.chartOfAccounts != null, "chartOfAccounts should be seeded");
        client.assert(response.body.data.bankAccounts != null, "bankAccounts should be seeded");
    });
%}

