# ===========================================================================
# Step 5.1.1: Look-Back Rate (Warning Flag)
# funding_date = 2026-05-23 — no exact rate exists for INR→USD on this date,
# but a rate exists on 2026-05-22 (within 7-day look-back window).
# Expected: rateSource = LOOKBACK, rateDateUsed = 2026-05-22, rateWarning = true
# ===========================================================================
# @name step_5_1_1_lookback_injection
POST {{baseUrl}}/api/v1/finance/funding/capital-injections
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "target_entity_code": "IN-TEST",
  "funding_source": "FOUNDER_EQUITY",
  "amount": 50000.00,
  "funding_date": "2026-05-23",
  "source_account_id": "{{india_equity_account_id}}",
  "destination_account_id": "{{india_bank_account_id}}",
  "referenceNumber": "TST-LOOKBACK-001"
}

> {%
    client.test("Look-Back Injection — Status 201", function() {
        client.assert(response.status === 201, "Expected 201 Created, got " + response.status);
    });
    client.test("Look-Back Injection — rateSource = LOOKBACK", function() {
        client.assert(response.body.data.rateSource === "LOOKBACK",
            "Expected LOOKBACK, got " + response.body.data.rateSource);
    });
    client.test("Look-Back Injection — rateDateUsed = 2026-05-22", function() {
        client.assert(response.body.data.rateDateUsed === "2026-05-22",
            "Expected 2026-05-22 (nearest past rate), got " + response.body.data.rateDateUsed);
    });
    client.test("Look-Back Injection — rateWarning = true", function() {
        client.assert(response.body.data.rateWarning === true,
            "Expected true, got " + response.body.data.rateWarning);
    });
    client.test("Look-Back Injection — exchangeRateUsed matches rate from 2026-05-22", function() {
        client.assert(response.body.data.exchangeRateUsed === 0.012150,
            "Expected 0.012150 (INR→USD on 2026-05-22), got " + response.body.data.exchangeRateUsed);
    });
    if (response.body.data && response.body.data.capitalInjectionId) {
        client.global.set("lookback_injection_id", response.body.data.capitalInjectionId);
        client.log("Captured lookback_injection_id = " + response.body.data.capitalInjectionId);
    }
%}

