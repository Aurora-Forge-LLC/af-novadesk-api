# ===========================================================================
# Step 2.2.1: Create Duplicate Rate (Conflict Test)
# ===========================================================================
# @name step_2_2_1_create_duplicate_rate
POST {{baseUrl}}/api/v1/finance/exchange-rates
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "source_currency": "INR",
  "target_currency": "USD",
  "rate_date": "2026-05-26",
  "exchange_rate": 0.012050,
  "notes": "Duplicate — should be rejected"
}

> {%
    client.test("Duplicate Rate — Status 409", function() {
        client.assert(response.status === 409, "Expected 409 Conflict, got " + response.status);
    });
    client.test("Duplicate Rate — message contains 'already exists'", function() {
        client.assert(response.body.message != null, "message should be present");
        client.assert(response.body.message.toLowerCase().indexOf("already exists") !== -1,
            "Expected 'already exists' in message, got: " + response.body.message);
    });
    client.test("Duplicate Rate — success is false", function() {
        client.assert(response.body.success === false, "Expected success=false");
    });
%}

