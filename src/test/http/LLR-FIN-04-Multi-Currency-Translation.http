# ===========================================================================
# Step 1.4.1: Discover Funding Accounts
# NOTE: This request MUST be run and the output inspected to capture the
# account IDs. The script below scans the array for the required roles.
# If the script doesn't find them, you may need to manually inspect the
# response and set the variables.
# ===========================================================================
# @name step_1_4_1_discover_accounts
GET {{baseUrl}}/api/v1/finance/accounts
Authorization: Bearer {{authToken}}

> {%
    client.test("List Accounts — Status 200", function() {
        client.assert(response.status === 200, "Expected 200 OK, got " + response.status);
    });
    client.test("List Accounts — data is an array", function() {
        client.assert(Array.isArray(response.body.data), "data should be an array");
    });

    // Discover India accounts
    if (Array.isArray(response.body.data)) {
        var indiaEntityId = client.global.get("india_entity_id");
        var usEntityId = client.global.get("us_entity_id");

        for (var i = 0; i < response.body.data.length; i++) {
            var acc = response.body.data[i];
            if (acc.legalEntityId === indiaEntityId) {
                if (acc.accountRole === "FOUNDER_EQUITY" && !client.global.get("india_equity_account_id")) {
                    client.global.set("india_equity_account_id", acc.id);
                    client.log("Captured india_equity_account_id = " + acc.id + " (" + acc.accountName + ")");
                }
                if ((acc.accountRole === "BANK_OPERATING" || acc.accountRole === "CASH") && !client.global.get("india_bank_account_id")) {
                    client.global.set("india_bank_account_id", acc.id);
                    client.log("Captured india_bank_account_id = " + acc.id + " (" + acc.accountName + ")");
                }
            }
            if (acc.legalEntityId === usEntityId) {
                if (acc.accountRole === "FOUNDER_EQUITY" && !client.global.get("us_equity_account_id")) {
                    client.global.set("us_equity_account_id", acc.id);
                    client.log("Captured us_equity_account_id = " + acc.id + " (" + acc.accountName + ")");
                }
                if ((acc.accountRole === "BANK_OPERATING" || acc.accountRole === "CASH") && !client.global.get("us_bank_account_id")) {
                    client.global.set("us_bank_account_id", acc.id);
                    client.log("Captured us_bank_account_id = " + acc.id + " (" + acc.accountName + ")");
                }
            }
        }
    }

    client.test("Account Discovery — india_equity_account_id captured", function() {
        client.assert(client.global.get("india_equity_account_id") != null,
            "India FOUNDER_EQUITY account not found. Inspect the response manually.");
    });
    client.test("Account Discovery — india_bank_account_id captured", function() {
        client.assert(client.global.get("india_bank_account_id") != null,
            "India BANK_OPERATING/CASH account not found. Inspect the response manually.");
    });
    client.test("Account Discovery — us_equity_account_id captured", function() {
        client.assert(client.global.get("us_equity_account_id") != null,
            "US FOUNDER_EQUITY account not found. Inspect the response manually.");
    });
    client.test("Account Discovery — us_bank_account_id captured", function() {
        client.assert(client.global.get("us_bank_account_id") != null,
            "US BANK_OPERATING/CASH account not found. Inspect the response manually.");
    });
%}

