# ===========================================================================
# Step 6.4.1: Multi-Entity Consolidated Report (Always USD)
# ===========================================================================
# @name step_6_4_1_consolidated_report
GET {{baseUrl}}/api/v1/finance/reports/consolidated?entityIds={{us_entity_id}}&entityIds={{india_entity_id}}
Authorization: Bearer {{authToken}}

> {%
    client.test("Consolidated Report — Status 200", function() {
        client.assert(response.status === 200, "Expected 200 OK, got " + response.status);
    });
    client.test("Consolidated Report — entitySummaries has 2 entries", function() {
        client.assert(response.body.data.entitySummaries != null, "entitySummaries should be present");
        client.assert(response.body.data.entitySummaries.length === 2,
            "Expected 2, got " + (response.body.data.entitySummaries ? response.body.data.entitySummaries.length : 0));
    });
    client.test("Consolidated Report — totalDebitsUsd present", function() {
        client.assert(response.body.data.totalDebitsUsd != null, "totalDebitsUsd should be present");
    });
    client.test("Consolidated Report — totalCreditsUsd present", function() {
        client.assert(response.body.data.totalCreditsUsd != null, "totalCreditsUsd should be present");
    });
    client.test("Consolidated Report — netPositionUsd present", function() {
        client.assert(response.body.data.netPositionUsd != null, "netPositionUsd should be present");
    });
    if (response.body.data.entitySummaries) {
        for (var i = 0; i < response.body.data.entitySummaries.length; i++) {
            var s = response.body.data.entitySummaries[i];
            client.assert(s.entityCode != null, "entityCode missing for summary " + i);
            client.assert(s.baseCurrency != null, "baseCurrency missing for summary " + i);
            client.assert(s.totalDebitsLocal != null, "totalDebitsLocal missing for summary " + i);
            client.assert(s.totalDebitsUsd != null, "totalDebitsUsd missing for summary " + i);
            client.assert(s.totalCreditsLocal != null, "totalCreditsLocal missing for summary " + i);
            client.assert(s.totalCreditsUsd != null, "totalCreditsUsd missing for summary " + i);
            if (s.baseCurrency === "USD") {
                client.assert(s.totalDebitsLocal === s.totalDebitsUsd,
                    "USD entity totalDebitsLocal should equal totalDebitsUsd");
            }
        }
    }
%}

