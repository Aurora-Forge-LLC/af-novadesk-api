# ===========================================================================
# Step 2.8.1: Create Second Rate for Deletion
# ===========================================================================
# @name step_2_8_1_create_rate_to_delete
POST {{baseUrl}}/api/v1/finance/exchange-rates
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "source_currency": "NPR",
  "target_currency": "USD",
  "rate_date": "2026-05-26",
  "exchange_rate": 0.007512
}

> {%
    client.test("Create Rate to Delete — Status 201", function() {
        client.assert(response.status === 201, "Expected 201 Created, got " + response.status);
    });
    if (response.body.data && response.body.data.id) {
        client.global.set("rate_id_to_delete", response.body.data.id);
