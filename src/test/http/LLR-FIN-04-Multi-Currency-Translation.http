        client.assert(response.status === 200, "Expected 200 OK, got " + response.status);
    });
    client.test("CSV Upload — data.totalRows = 6", function() {
        client.assert(response.body.data.totalRows === 6,
            "Expected 6, got " + response.body.data.totalRows);
    });
    client.test("CSV Upload — data.successCount = 6", function() {
        client.assert(response.body.data.successCount === 6,
            "Expected 6, got " + response.body.data.successCount);
    });
    client.test("CSV Upload — data.skippedCount = 0", function() {
        client.assert(response.body.data.skippedCount === 0,
            "Expected 0, got " + response.body.data.skippedCount);
    });
    client.test("CSV Upload — data.errorCount = 0", function() {
        client.assert(response.body.data.errorCount === 0,
            "Expected 0, got " + response.body.data.errorCount);
    });
    client.test("CSV Upload — data.errors is empty or null", function() {
        client.assert(!response.body.data.errors || response.body.data.errors.length === 0,
            "Expected empty errors array");
    });
%}

