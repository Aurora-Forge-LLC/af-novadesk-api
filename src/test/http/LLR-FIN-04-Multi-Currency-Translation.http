# ===========================================================================
# Step 2.1.1: Create Exchange Rate (Manual) — INR→USD
# ===========================================================================
# @name step_2_1_1_create_rate_inr_usd
POST {{baseUrl}}/api/v1/finance/exchange-rates
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "source_currency": "INR",
  "target_currency": "USD",
  "rate_date": "2026-05-26",
  "exchange_rate": 0.012045,
  "notes": "Test rate — Central Bank of India"
}

> {%
    client.test("Create Rate — Status 201", function() {
        client.assert(response.status === 201, "Expected 201 Created, got " + response.status);
    });
    client.test("Create Rate — data.id is valid UUID", function() {
        client.assert(response.body.data != null, "data should not be null");
        client.assert(response.body.data.id != null, "data.id should be present");
    });
    client.test("Create Rate — sourceCurrency = INR", function() {
        client.assert(response.body.data.sourceCurrency === "INR",
            "Expected INR, got " + response.body.data.sourceCurrency);
    });
    client.test("Create Rate — targetCurrency = USD", function() {
        client.assert(response.body.data.targetCurrency === "USD",
            "Expected USD, got " + response.body.data.targetCurrency);
    });
    client.test("Create Rate — rateDate = 2026-05-26", function() {
        client.assert(response.body.data.rateDate === "2026-05-26",
            "Expected 2026-05-26, got " + response.body.data.rateDate);
    });
    client.test("Create Rate — exchangeRate = 0.012045", function() {
        client.assert(response.body.data.exchangeRate === 0.012045,
            "Expected 0.012045, got " + response.body.data.exchangeRate);
    });
    client.test("Create Rate — rateSource = MANUAL", function() {
        client.assert(response.body.data.rateSource === "MANUAL",
            "Expected MANUAL, got " + response.body.data.rateSource);
    });
    client.test("Create Rate — status = ACTIVE", function() {
        client.assert(response.body.data.status === "ACTIVE",
            "Expected ACTIVE, got " + response.body.data.status);
    });
    client.test("Create Rate — approvedBy is null", function() {
        client.assert(response.body.data.approvedBy == null,
            "Expected null approvedBy, got " + response.body.data.approvedBy);
    });
    if (response.body.data && response.body.data.id) {
        client.global.set("rate_id_1", response.body.data.id);
        client.log("Captured rate_id_1 = " + response.body.data.id);
    }
%}

