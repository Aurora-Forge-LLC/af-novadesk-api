# ===========================================================================
# Step 4.4.1: List Capital Injections (Paginated)
# ===========================================================================
# @name step_4_4_1_list_injections
GET {{baseUrl}}/api/v1/finance/funding/capital-injections?entity_code=IN-TEST&page=0&size=20
Authorization: Bearer {{authToken}}

> {%
    client.test("List Injections — Status 200", function() {
        client.assert(response.status === 200, "Expected 200 OK, got " + response.status);
    });
    client.test("List Injections — data.content is array", function() {
        client.assert(response.body.data.content != null, "content should be present");
        client.assert(Array.isArray(response.body.data.content), "content should be an array");
    });
    client.test("List Injections — includes injection from 4.2.1", function() {
        var inrId = client.global.get("inr_injection_id");
        var found = false;
        if (Array.isArray(response.body.data.content)) {
            for (var i = 0; i < response.body.data.content.length; i++) {
                if (response.body.data.content[i].id === inrId) {
                    found = true;
                    client.assert(response.body.data.content[i].amountLocal != null, "amountLocal missing");
                    client.assert(response.body.data.content[i].currencyLocal != null, "currencyLocal missing");
                    client.assert(response.body.data.content[i].amountUsd != null, "amountUsd missing");
                    client.assert(response.body.data.content[i].exchangeRateUsed != null, "exchangeRateUsed missing");
                    client.assert(response.body.data.content[i].rateSource != null, "rateSource missing");
                    client.assert(response.body.data.content[i].rateWarning !== undefined, "rateWarning missing");
                    break;
                }
            }
        }
        client.assert(found, "Injection " + inrId + " not found in list");
    });
%}

