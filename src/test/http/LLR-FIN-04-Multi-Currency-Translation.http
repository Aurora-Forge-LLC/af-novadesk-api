# ===========================================================================
# Step 5.3.2: Manual Rate Without Justification (Validation Error)
# ===========================================================================
# @name step_5_3_2_manual_rate_no_justification
POST {{baseUrl}}/api/v1/finance/funding/capital-injections
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "target_entity_code": "IN-TEST",
  "funding_source": "FOUNDER_EQUITY",
  "amount": 25000.00,
  "funding_date": "2026-05-01",
  "source_account_id": "{{india_equity_account_id}}",
  "destination_account_id": "{{india_bank_account_id}}",
  "referenceNumber": "TST-NOJUST-001",
  "manual_exchange_rate": 0.012500,
  "manual_rate_approved_by": "finance.manager@example.com"
}

> {%
    client.test("No Justification — Status 400", function() {
        client.assert(response.status === 400, "Expected 400 Bad Request, got " + response.status);
    });
    client.test("No Justification — message about justification", function() {
        client.assert(response.body.message != null, "message should be present");
        client.assert(response.body.message.toLowerCase().indexOf("justification") !== -1,
            "Expected 'justification' in message, got: " + response.body.message);
    });
%}

