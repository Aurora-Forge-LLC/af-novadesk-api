<?xml version="1.0" encoding="UTF-8"?>
<!--
  settings.xml
  Maven settings for CI/CD pipelines using Amazon CodeArtifact.
  Used by GitHub Actions workflows (maven-build.yml, maven-deploy.yml, release.yml).

  Environment variables consumed (injected by each GitHub Actions workflow step):
    CODEARTIFACT_AUTH_TOKEN  - short-lived token from `aws codeartifact get-authorization-token`
    CODEARTIFACT_DOMAIN      - CodeArtifact domain name          (GitHub Variable: CODEARTIFACT_DOMAIN)
    CODEARTIFACT_OWNER       - AWS Account ID that owns the domain (GitHub Variable: CODEARTIFACT_OWNER)
    AWS_REGION               - AWS region                         (GitHub Variable: AWS_REGION)

  Repository strategy:
    maven-central-store  → proxy for external dependencies (Maven Central)
    af-snapshots         → internal SNAPSHOT artifacts only  (publish target)
    af-releases          → internal RELEASE  artifacts only  (publish target)
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0
                              https://maven.apache.org/xsd/settings-1.2.0.xsd">

    <servers>
        <!-- Used by distributionManagement in pom.xml for publishing SNAPSHOTs -->
        <server>
            <id>af-snapshots</id>
            <username>aws</username>
            <password>${env.CODEARTIFACT_AUTH_TOKEN}</password>
        </server>

        <!-- Used by distributionManagement in pom.xml for publishing RELEASEs -->
        <server>
            <id>af-releases</id>
            <username>aws</username>
            <password>${env.CODEARTIFACT_AUTH_TOKEN}</password>
        </server>

        <!-- Used for resolving external dependencies via maven-central-store proxy -->
        <server>
            <id>maven-central-store</id>
            <username>aws</username>
            <password>${env.CODEARTIFACT_AUTH_TOKEN}</password>
        </server>
    </servers>

    <!--
      Route ALL dependency resolution through maven-central-store (CodeArtifact proxy
      for Maven Central). This keeps af-snapshots and af-releases clean — they only
      ever receive artifacts published by this project, never transitive downloads.
    -->
    <mirrors>
        <mirror>
            <id>maven-central-store</id>
            <name>CodeArtifact Maven Central Store</name>
            <url>https://${env.CODEARTIFACT_DOMAIN}-${env.CODEARTIFACT_OWNER}.d.codeartifact.${env.AWS_REGION}.amazonaws.com/maven/maven-central-store/</url>
            <mirrorOf>central,*,!af-snapshots,!af-releases</mirrorOf>
        </mirror>
    </mirrors>

    <profiles>
        <profile>
            <id>codeartifact</id>
            <repositories>
                <!-- Internal SNAPSHOT resolution (consume other internal SNAPSHOTs) -->
                <repository>
                    <id>af-snapshots</id>
                    <url>https://${env.CODEARTIFACT_DOMAIN}-${env.CODEARTIFACT_OWNER}.d.codeartifact.${env.AWS_REGION}.amazonaws.com/maven/af-snapshots/</url>
                    <releases><enabled>false</enabled></releases>
                    <snapshots><enabled>true</enabled></snapshots>
                </repository>

                <!-- Internal RELEASE resolution (consume other internal releases) -->
                <repository>
                    <id>af-releases</id>
                    <url>https://${env.CODEARTIFACT_DOMAIN}-${env.CODEARTIFACT_OWNER}.d.codeartifact.${env.AWS_REGION}.amazonaws.com/maven/af-releases/</url>
                    <releases><enabled>true</enabled></releases>
                    <snapshots><enabled>false</enabled></snapshots>
                </repository>

                <!-- External dependency resolution — maven-central-store only -->
                <repository>
                    <id>maven-central-store</id>
                    <url>https://${env.CODEARTIFACT_DOMAIN}-${env.CODEARTIFACT_OWNER}.d.codeartifact.${env.AWS_REGION}.amazonaws.com/maven/maven-central-store/</url>
                    <releases><enabled>true</enabled></releases>
                    <snapshots><enabled>false</enabled></snapshots>
                </repository>
            </repositories>
            <pluginRepositories>
                <pluginRepository>
                    <id>maven-central-store</id>
                    <url>https://${env.CODEARTIFACT_DOMAIN}-${env.CODEARTIFACT_OWNER}.d.codeartifact.${env.AWS_REGION}.amazonaws.com/maven/maven-central-store/</url>
                    <releases><enabled>true</enabled></releases>
                    <snapshots><enabled>false</enabled></snapshots>
                </pluginRepository>
            </pluginRepositories>
        </profile>
    </profiles>

    <activeProfiles>
        <activeProfile>codeartifact</activeProfile>
    </activeProfiles>

</settings>

